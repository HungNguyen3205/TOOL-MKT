APP_NAME="AI Facebook Content Tool"
APP_ENV=local
APP_KEY=base64:6z5dKffh2MaSmwjQMo48KIepvVH3MegENKhuD8hy81U=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
FRONTEND_URL=http://localhost:5173

# AI CONFIGURATION
AI_TEXT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=60
GEMINI_MAX_OUTPUT_TOKENS=800

AI_IMAGE_PROVIDER=pollinations
POLLINATIONS_API_KEY=
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_IMAGE_MODEL=flux
POLLINATIONS_IMAGE_SIZE=1024x1024
POLLINATIONS_IMAGE_QUALITY=low
POLLINATIONS_TIMEOUT=180

AI_FALLBACK_ENABLED=false
IMAGE_FALLBACK_ENABLED=false

CONTENT_VARIANTS_DEFAULT=1
CONTENT_VARIANTS_MAX=3

IMAGE_AUTO_GENERATE=false
IMAGE_GENERATE_AFTER_APPROVAL=true
IMAGE_MAX_PER_REQUEST=1
IMAGE_DAILY_LIMIT=20
IMAGE_RETRY_TIMES=0

APP_TIMEZONE=Asia/Ho_Chi_Minh

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/facebook/callback
FACEBOOK_FRONTEND_REDIRECT_URL=http://localhost:5173/facebook-pages
FACEBOOK_SCOPES=pages_show_list,pages_manage_posts,pages_read_engagement
FACEBOOK_PUBLISH_QUEUE=facebook-publish
